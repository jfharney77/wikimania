# ── LLM Provider ──────────────────────────────────────────────────────────────
# Set PROVIDER to one of: groq, cerebras, together, openrouter, fireworks, ollama
PROVIDER=groq

# API key — used for all cloud providers (also accepts GROQ_API_KEY for backward compat)
API_KEY=your_api_key_here

# Models
MODEL_FAST=llama-3.1-8b-instant
MODEL_REASONING=llama-3.3-70b-versatile

# Optional: override the provider base URL (e.g. for a custom/self-hosted endpoint)
# API_BASE_URL=https://api.groq.com/openai/v1

# ── Pipeline ──────────────────────────────────────────────────────────────────
# Set to true to use the LangGraph-based pipeline instead of the default one.
USE_LANGGRAPH=false

# ── Parallelism ────────────────────────────────────────────────────────────────
# Articles to write concurrently. Keep at 1 for rate-limited free tiers.
# Raise to 3-5 when using providers with generous limits (Cerebras, paid plans).
PARALLEL_WRITES=1
# Seconds between batches of article writes.
BATCH_DELAY=8

# ── Ollama (local dev — WSL) ───────────────────────────────────────────────────
# PROVIDER=ollama
# MODEL_FAST=qwen2.5
# MODEL_REASONING=qwen2.5:32b
# OLLAMA_BASE_URL=http://172.30.48.1:11434

# ── Brainstorm agent (open-source model) ───────────────────────────────────────
# Runs independently of PROVIDER. Defaults to Ollama so it uses a local OSS model
# even when the rest of the app is on a cloud provider. Set to "inherit" to reuse
# the reasoning model/provider instead. Requires OLLAMA_BASE_URL when on ollama.
BRAINSTORM_PROVIDER=ollama
MODEL_BRAINSTORM=qwen2.5

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/wikimania

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=24

# Bootstrap: if no users exist at startup, this admin account is created automatically.
FIRST_ADMIN_USERNAME=john
FIRST_ADMIN_PASSWORD=change-me

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Gmail ingestion (optional) ─────────────────────────────────────────────────
# Create an OAuth client (type: Web application) in Google Cloud Console with
# the gmail.readonly scope and add GOOGLE_REDIRECT_URI to its redirect URIs.
# Leave blank to disable the email features entirely.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/api/gmail/oauth/callback
# Seconds between background sync cycles (label + "+wiki" forwards).
GMAIL_SYNC_INTERVAL=120
# Sub-address suffix for forward-to-wiki ingestion (me+wiki@gmail.com).
GMAIL_INGEST_SUFFIX=+wiki
# Extra redaction regexes (JSON array) scrubbed from email bodies before storage.
# Defaults already cover phone numbers and one-time codes.
# REDACTION_PATTERNS=["\\b\\d{1,5} [A-Z][a-z]+ (Street|St|Ave|Avenue|Road|Rd)\\b"]
# Set to false to skip the LLM entity-extraction call during email ingestion.
EMAIL_ENTITY_LLM=true
